---
interface Props { title: string; description: string; image?: string; }
const { title, description, image = '/images/sunset.webp' } = Astro.props;
const site = Astro.site ?? new URL('https://example.com');
const canonical = new URL(Astro.url.pathname, site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={new URL(image, site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/src/styles/global.css" />
</head>
<body>
  <slot name="before-nav" />
  <nav class="site-nav" aria-label="Main navigation">
    <div class="container nav-inner">
      <a href="/" class="brand">Lens&nbsp;&amp;&nbsp;Light</a>
      <input type="checkbox" id="nav-toggle" aria-label="Open menu" />
      <label for="nav-toggle" class="burger" aria-hidden="true"><span></span></label>
      <ul class="nav-links">
        <li><a href="/portfolio">Portfolio</a></li>
        <li><a href="/journal">Journal</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><button id="theme-btn" aria-label="Toggle light and dark theme">&#9686;</button></li>
      </ul>
    </div>
  </nav>
  <slot />
  <footer class="site-footer">
    <div class="container">
      <p>&copy; {new Date().getFullYear()} Lens &amp; Light &middot; A daily photoblog</p>
      <p class="foot-links"><a href="/portfolio">Portfolio</a> &middot; <a href="/journal">Journal</a> &middot; <a href="/contact">Contact</a></p>
    </div>
  </footer>
  <style>
    .site-nav { position: sticky; top: 0; z-index: 50; backdrop-filter: blur(10px); background: rgba(28,27,26,0.72); border-bottom: 1px solid rgba(245,240,232,0.08); }
    body[data-theme='light'] .site-nav { background: rgba(250,247,242,0.8); border-bottom-color: rgba(42,40,37,0.08); }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; min-height: 64px; gap: 1rem; }
    .brand { font-family: var(--font-serif); font-size: 1.25rem; letter-spacing: 0.04em; }
    .nav-links { display: flex; gap: 1.6rem; list-style: none; align-items: center; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.15em; }
    .nav-links a { opacity: 0.75; transition: opacity 0.25s; }
    .nav-links a:hover { opacity: 1; }
    #theme-btn { background: none; border: none; color: inherit; font-size: 1rem; cursor: pointer; }
    .burger { display: none; }
    #nav-toggle { display: none; }
    @media (max-width: 720px) {
      .burger { display: block; width: 24px; height: 16px; position: relative; cursor: pointer; }
      .burger span, .burger::before, .burger::after { content: ''; position: absolute; left: 0; width: 100%; height: 2px; background: currentColor; }
      .burger span { top: 7px; } .burger::before { top: 0; } .burger::after { top: 14px; }
      .nav-links { position: absolute; top: 64px; left: 0; right: 0; flex-direction: column; background: inherit; padding: 1.5rem 0; display: none; }
      #nav-toggle:checked ~ .nav-links { display: flex; }
    }
    .site-footer { border-top: 1px solid rgba(245,240,232,0.08); padding: 2.5rem 0; font-size: 0.85rem; opacity: 0.7; }
    body[data-theme='light'] .site-footer { border-top-color: rgba(42,40,37,0.08); }
    .foot-links { margin-top: 0.4rem; }
  </style>
  <script>
    // Theme toggle (persisted)
    const btn = document.getElementById('theme-btn');
    const saved = localStorage.getItem('theme');
    if (saved === 'light') document.body.dataset.theme = 'light';
    btn?.addEventListener('click', () => {
      const light = document.body.dataset.theme !== 'light';
      document.body.dataset.theme = light ? 'light' : '';
      localStorage.setItem('theme', light ? 'light' : 'dark');
    });
    // Scroll reveals - respects reduced motion; skips parallax on touch devices (perf)
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = matchMedia('(pointer: coarse)').matches;
    if (!reduced) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) { e.target.classList.add('revealed'); io.unobserve(e.target); }
        }
      }, { threshold: 0.15 });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      if (!coarse) {
        const items = [...document.querySelectorAll('[data-parallax]')];
        const onScroll = () => {
          for (const el of items) {
            const p = parseFloat(el.dataset.parallax || '0');
            if (!p) continue;
            const r = el.getBoundingClientRect();
            const mid = (r.top + r.bottom) / 2 - innerHeight / 2;
            el.style.transform = `translateY(${(-mid * p * 0.06).toFixed(1)}px)`;
          }
        };
        addEventListener('scroll', () => requestAnimationFrame(onScroll), { passive: true });
      }
    } else {
      document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('revealed'));
    }
  </script>
</body>
</html>
